{
  "name": "@chainwell/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "pnpm --filter @chainwell/game build",
    "sync": "pnpm build:web && cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:android": "pnpm sync && cap run android",
    "assets": "node resources/mark.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#0E0F16' --iconBackgroundColorDark '#0E0F16' --splashBackgroundColor '#0E0F16' --splashBackgroundColorDark '#0E0F16'",
    "aab": "fastlane android aab",
    "beta:ios": "fastlane ios beta",
    "beta:android": "fastlane android internal"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "sharp": "0.32.6"
  }
}
