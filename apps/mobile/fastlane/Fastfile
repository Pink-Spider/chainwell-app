# Chainwell — TestFlight / Play internal test lanes.
# Run from apps/mobile:  fastlane ios beta   |   fastlane android internal
# Both lanes rebuild the web app and `cap sync` first, so the native shells always carry the latest dist.

default_platform(:ios)

def sync_web
  # fastlane runs `sh` inside fastlane/; the package lives one level up
  sh("cd .. && pnpm --filter @chainwell/game build")
  sh("cd .. && npx cap sync")
end

# Signing without an Xcode account: Apple Distribution cert (in the login keychain) + the
# "Chainwell App Store" provisioning profile (installed from developer.apple.com).
TEAM = ENV.fetch("FASTLANE_TEAM_ID", "Z53YTTRR32")
PROFILE = ENV.fetch("IOS_PROFILE", "Chainwell App Store")
# Applied to the App target only (not as global xcargs): SPM packages with resource bundles, e.g. RevenueCat,
# refuse a manually specified provisioning profile.
def manual_signing
  update_code_signing_settings(
    path: "ios/App/App.xcodeproj",
    targets: ["App"],
    use_automatic_signing: false,
    team_id: TEAM,
    code_sign_identity: "Apple Distribution",
    profile_name: PROFILE,
    bundle_identifier: "io.pinkspider.chainwell",
  )
end

# Play Developer API: shared org service account play-publisher@pink-spider-play (see sudoku-app/docs/play-api-automation.md).
# Key lives outside the repo; override with PLAY_JSON_KEY.
PLAY_KEY = File.expand_path(ENV.fetch("PLAY_JSON_KEY", "~/.pink-spider/secrets/play-publisher-key.json"))

def asc_key
  # Team key ASC-API-KEY (App Manager). Override with ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH.
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID", "8FZTAA3T77"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "fe387068-11c4-467b-b275-c7ba5d54a813"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_8FZTAA3T77.p8")),
  )
end

platform :ios do
  desc "Archive with automatic signing and export an App Store IPA (upload it with Transporter). Needs Xcode signed in + FASTLANE_TEAM_ID."
  lane :ipa do
    sync_web
    manual_signing
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: { signingStyle: "manual", provisioningProfiles: { "io.pinkspider.chainwell" => PROFILE } },
      output_directory: "build",
      output_name: "Chainwell.ipa",
    )
    UI.success("IPA: build/Chainwell.ipa → Transporter 앱으로 업로드")
  end

  desc "Archive with automatic signing and upload to TestFlight"
  lane :beta do
    sync_web
    # App Store Connect API key (Users and Access → Integrations → App Store Connect API):
    #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to AuthKey_XXXX.p8)
    asc_key
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: latest_testflight_build_number(initial_build_number: 0) + 1)
    manual_signing
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: { signingStyle: "manual", provisioningProfiles: { "io.pinkspider.chainwell" => PROFILE } },
      output_directory: "build",
    )
    upload_to_testflight(skip_waiting_for_build_processing: true, distribute_external: false)
  end
end

platform :android do
  desc "Build a signed AAB and upload to the Play internal testing track"
  lane :internal do
    sync_web
    # Version code = number of previous uploads + 1 (read from Play). Falls back to 1 for the first manual upload.
    codes = google_play_track_version_codes(track: "internal", json_key: PLAY_KEY) rescue []
    next_code = (codes.max || 0) + 1
    gradle(task: "bundle", build_type: "Release", project_dir: "android", properties: { "versionCode" => next_code })
    upload_to_play_store(track: "internal", aab: "android/app/build/outputs/bundle/release/app-release.aab", json_key: PLAY_KEY, skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
  end

  desc "Build a signed AAB and upload it to the PRODUCTION track as a DRAFT (no rollout; a person submits for review in the console)"
  lane :production do
    sync_web
    codes = google_play_track_version_codes(track: "internal", json_key: PLAY_KEY) rescue []
    prod = google_play_track_version_codes(track: "production", json_key: PLAY_KEY) rescue []
    next_code = ([codes.max || 0, prod.max || 0].max) + 1
    gradle(task: "bundle", build_type: "Release", project_dir: "android", properties: { "versionCode" => next_code })
    upload_to_play_store(track: "production", release_status: "draft", aab: "android/app/build/outputs/bundle/release/app-release.aab", json_key: PLAY_KEY, skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true)
    UI.success("Production draft created with versionCode #{next_code}. Review and submit in Play Console.")
  end

  desc "Build a signed AAB only (manual upload in Play Console). Usage: fastlane android aab version_code:2"
  lane :aab do |opts|
    sync_web
    code = (opts[:version_code] || 1).to_i
    gradle(task: "bundle", build_type: "Release", project_dir: "android", properties: { "versionCode" => code })
    UI.success("AAB (versionCode #{code}): android/app/build/outputs/bundle/release/app-release.aab")
  end
end
